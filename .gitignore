# ==============================================================
#  Unity .gitignore
#  최신본: https://github.com/github/gitignore/blob/main/Unity.gitignore
# ==============================================================

# Unity 생성 폴더 (커밋하지 않음)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Rider / VS / IDE
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 생성 meta (대응 에셋이 무시될 때만)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt
crashlytics-build.properties

# 빌드 산출물
*.apk
*.aab
*.ipa
*.app
*.unitypackage

# Addressables 패킹 결과
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# OS
.DS_Store
Thumbs.db
desktop.ini

# 이미지 확인용 모아보기(생성 결과 미리보기) — 커밋하지 않음
/docs/art-preview/

# Live2D Cubism SDK — 라이선스상 저장소에 올리지 않음(각자 내려받아 임포트: docs/live2d.md)
/Assets/Live2D/
/Assets/Live2D.meta
/Assets/csc.rsp
/Assets/csc.rsp.meta
/Assets/mcs.rsp
/Assets/mcs.rsp.meta

# 효과음 라보(soundeffect-lab.info) 소리 — 재배포 금지라 저장소에 넣지 않음. 각 PC에서 node tools/audio/fetch-sfx-lab.js 로 받음
/Assets/_Project/Resources/Audio/SFX/Lab/
/Assets/_Project/Resources/Audio/SFX/Lab.meta
